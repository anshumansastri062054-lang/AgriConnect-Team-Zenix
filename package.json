{
  "name": "agriconnect-team-zenix",
  "private": true,
  "scripts": {
    "api:install": "npm --prefix apps/api install",
    "api:dev": "npm --prefix apps/api run dev",
    "api:build": "npm --prefix apps/api run build",
    "api:seed": "npm --prefix apps/api run seed",
    "db:generate": "npm --prefix apps/api exec prisma generate",
    "db:validate": "npm --prefix apps/api exec prisma validate",
    "web": "python -m http.server 5500 --directory apps/web"
  }
}
